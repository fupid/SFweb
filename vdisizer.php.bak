<?php
// ดึงข้อมูล Inventory หรือกำหนดค่าเริ่มต้นสำหรับ VDI Profile
$vdi_profiles = [
    "task" => ["name" => "Task Worker", "vcpu" => 1, "ram" => 2, "ratio" => 10, "iops" => 15],
    "office" => ["name" => "Office Worker", "vcpu" => 2, "ram" => 4, "ratio" => 6, "iops" => 30],
    "power" => ["name" => "Power User", "vcpu" => 4, "ram" => 8, "ratio" => 3, "iops" => 60],
    "designer" => ["name" => "3D Designer (GPU)", "vcpu" => 8, "ram" => 32, "ratio" => 2, "iops" => 150, "vram" => 4]
];
?>

<!DOCTYPE html>
<html lang="th">
<head>
    <meta charset="UTF-8">
    <title>VDI Smart Sizer Pro v1.0</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;700;900&display=swap" rel="stylesheet">
    <style>
        body { font-family: 'Inter', sans-serif; background-color: #f8fafc; }
        .glass-card { background: rgba(255, 255, 255, 0.9); backdrop-filter: blur(10px); border-radius: 2rem; border: 1px solid #e2e8f0; }
        .eds-input { width: 100%; border: 2px solid #f1f5f9; border-radius: 12px; padding: 10px; font-weight: 600; outline: none; }
        .eds-input:focus { border-color: #2563eb; background: #f0f7ff; }
        .toggle-checkbox:checked + .toggle-label { background-color: #2563eb; }
    </style>
</head>
<body class="p-6 md:p-12">

<div class="max-w-7xl mx-auto">
    <div class="mb-10">
        <h1 class="text-4xl font-black text-slate-800 tracking-tighter italic uppercase">VDI <span class="text-blue-600">Smart Sizer</span></h1>
        <p class="text-slate-500 text-xs font-bold uppercase tracking-[0.3em]">Virtual Desktop Infrastructure Planner</p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
        <div class="lg:col-span-1 space-y-6">
            <div class="glass-card p-8 border-t-8 border-t-slate-800">
                <h3 class="text-lg font-black mb-6 uppercase tracking-tight">Step 1: User Profiles</h3>
                
                <div class="space-y-4">
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase">Standard Users (Task/Office)</span>
                        <input type="number" id="stdUsers" class="eds-input mt-2" value="50" oninput="calculateVDI()">
                    </div>
                    <div>
                        <span class="text-[10px] font-bold text-slate-400 uppercase">Power Users (Developer)</span>
                        <input type="number" id="powerUsers" class="eds-input mt-2" value="10" oninput="calculateVDI()">
                    </div>
                    
                    <div class="pt-4 border-t border-slate-100">
                        <label class="flex items-center cursor-pointer">
                            <div class="relative">
                                <input type="checkbox" id="enable3D" class="sr-only" onchange="toggle3D()">
                                <div class="w-10 h-6 bg-slate-200 rounded-full shadow-inner transition"></div>
                                <div class="dot absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition"></div>
                            </div>
                            <div class="ml-3 text-slate-700 font-bold text-sm uppercase">Include 3D Designers (Optional)</div>
                        </label>
                        
                        <div id="panel3D" class="mt-4 hidden space-y-4 bg-blue-50 p-4 rounded-2xl">
                            <div>
                                <span class="text-[10px] font-bold text-blue-600 uppercase">3D Designer Users</span>
                                <input type="number" id="designerUsers" class="eds-input mt-2" value="5" oninput="calculateVDI()">
                            </div>
                            <p class="text-[9px] text-blue-400 italic font-medium">* Calculations include vGPU VRAM requirements (4GB/User)</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="lg:col-span-2 space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="glass-card p-8 bg-slate-900 text-white border-none">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total Physical Cores (N+1)</p>
                    <p class="text-5xl font-black mt-2 text-blue-400" id="resCPU">-</p>
                </div>
                <div class="glass-card p-8 bg-slate-900 text-white border-none">
                    <p class="text-[10px] font-bold text-slate-500 uppercase tracking-widest">Total RAM (GB)</p>
                    <p class="text-5xl font-black mt-2 text-emerald-400" id="resRAM">-</p>
                </div>
            </div>

            <div class="glass-card p-10">
                <h3 class="text-xl font-black text-slate-800 mb-8 uppercase tracking-tighter italic">Required Infrastructure Summary</h3>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
                    <div class="space-y-4">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">Storage Impact</p>
                        <div class="p-4 bg-slate-50 rounded-2xl">
                            <span class="block text-xs font-bold text-slate-500">Estimated IOPS</span>
                            <span class="text-2xl font-black text-slate-800" id="resIOPS">-</span>
                        </div>
                    </div>
                    <div class="space-y-4">
                        <p class="text-[10px] font-bold text-slate-400 uppercase">GPU Resources</p>
                        <div class="p-4 bg-blue-50 rounded-2xl">
                            <span class="block text-xs font-bold text-blue-500">vGPU VRAM Total</span>
                            <span class="text-2xl font-black text-blue-700" id="resVRAM">0 GB</span>
                        </div>
                    </div>
                    <div class="flex flex-col justify-center">
                        <div class="bg-blue-600 p-6 rounded-3xl text-white text-center">
                            <span class="block text-[10px] font-bold uppercase opacity-70 mb-1">Recommended Nodes</span>
                            <span class="text-4xl font-black" id="resNodes">-</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    function toggle3D() {
        const panel = document.getElementById('panel3D');
        const dot = document.querySelector('.dot');
        if (document.getElementById('enable3D').checked) {
            panel.classList.remove('hidden');
            dot.style.transform = 'translateX(100%)';
        } else {
            panel.classList.add('hidden');
            dot.style.transform = 'translateX(0)';
        }
        calculateVDI();
    }

    function calculateVDI() {
        const stdU = parseInt(document.getElementById('stdUsers').value) || 0;
        const pwrU = parseInt(document.getElementById('powerUsers').value) || 0;
        const dsgU = document.getElementById('enable3D').checked ? (parseInt(document.getElementById('designerUsers').value) || 0) : 0;

        // Profiles Logic
        // RAM (GB)
        const totalRAM = (stdU * 4) + (pwrU * 8) + (dsgU * 32);
        // CPU Cores (Physical) using Consolidation Ratios 
        const cpuCores = Math.ceil((stdU * 2 / 6) + (pwrU * 4 / 3) + (dsgU * 8 / 2));
        // IOPS
        const totalIOPS = (stdU * 30) + (pwrU * 60) + (dsgU * 150);
        // VRAM
        const totalVRAM = dsgU * 4;

        // Apply 15% System Overhead
        const finalRAM = Math.ceil(totalRAM * 1.15);
        const finalCPU = Math.ceil(cpuCores * 1.15);

        // N+1 Node Logic (Assuming each node has 32 Cores / 256GB RAM)
        const nodesByCPU = Math.ceil(finalCPU / 32);
        const nodesByRAM = Math.ceil(finalRAM / 256);
        const baseNodes = Math.max(nodesByCPU, nodesByRAM);
        const finalNodes = baseNodes + 1; // N+1

        // Update UI
        document.getElementById('resCPU').innerText = finalCPU;
        document.getElementById('resRAM').innerText = finalRAM + " GB";
        document.getElementById('resIOPS').innerText = totalIOPS.toLocaleString();
        document.getElementById('resVRAM').innerText = totalVRAM + " GB";
        document.getElementById('resNodes').innerText = finalNodes;
    }

    window.onload = calculateVDI;
</script>

</body>
</html>