<?php
$filename = 'inventory.json';
if ($_SERVER['REQUEST_METHOD'] === 'POST') {
    $jsonData = file_get_contents('php://input');
    if ($jsonData) { file_put_contents($filename, $jsonData); header('Content-Type: application/json'); echo json_encode(["status"=>"success"]); exit; }
}
if (!file_exists($filename)) {
    $defaultData = ["servers"=>[["name"=>"aServer-X5-2405","socket"=>2,"core"=>32,"freq"=>2.8,"baseRam"=>128,"maxDisk"=>12,"maxDimm"=>32]],"ssds"=>[480,960,1920,3840,7680],"hdds"=>[1200,2400,4000,8000,12000]];
    file_put_contents($filename, json_encode($defaultData, JSON_PRETTY_PRINT));
}
$inventoryData = file_get_contents($filename);
?>
