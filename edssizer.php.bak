                <p class="text-[11px] font-black text-blue-400 uppercase tracking-widest border-b border-white/5 pb-2">Hardware Summary</p>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">Total Nodes:</span><span class="text-lg font-black" id="sumNodes">-</span></div>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">Total Slots:</span><span class="text-lg font-black" id="sumSlots">- / -</span></div>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">Memory/Node:</span><span class="text-lg font-black text-emerald-400" id="sumRam">-</span></div>
            </div>

            <div class="space-y-6 border-r border-white/5 pr-6">
                <p class="text-[11px] font-black text-blue-400 uppercase tracking-widest border-b border-white/5 pb-2">Accessories BOM</p>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">10G Modules:</span><span class="text-lg font-black" id="sumModules">-</span></div>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">LC-LC Fibers:</span><span class="text-lg font-black" id="sumCables">-</span></div>
            </div>

            <div class="space-y-6 border-r border-white/5 pr-6">
                <p class="text-[11px] font-black text-blue-400 uppercase tracking-widest border-b border-white/5 pb-2">Pool Capacities (Net)</p>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">File/Object:</span><span class="text-lg font-black text-blue-400" id="sumFileUsable">-</span></div>
                <div class="flex justify-between items-center"><span class="text-xs text-slate-400 italic">Block Pool:</span><span class="text-lg font-black text-orange-400" id="sumBlockUsable">-</span></div>
            </div>

            <div class="flex flex-col justify-center text-center md:text-right">
                <p class="text-[10px] font-black text-blue-400 uppercase tracking-[0.4em] mb-2">Total Net Usable (TB)</p>
                <p class="text-7xl font-black tracking-tighter text-white" id="resUsable">0.0</p>
                <p class="text-[9px] text-slate-500 mt-4 leading-relaxed italic">* Incl. Binary Loss (931/1024)<br>and 15% Emergency Reservation.</p>
            </div>
        </div>
    </div>
</div>

<script>
    function runSizing() {
        const modelEl = document.getElementById('model');
        const maxSlots = parseInt(modelEl.value);
        const nodes = parseInt(document.getElementById('nodes').value) || 0;
        const ramBase = parseInt(modelEl.options[modelEl.selectedIndex].getAttribute('data-base'));
        const addRamDimm = parseInt(document.getElementById('addRamDimm').value) || 0;
        
        // 1. RAM Logic
        const ramBaseDimms = ramBase / 16; // Assuming 16GB base modules for calculation or specific chassis config
        const totalRamSlots = ramBaseDimms + addRamDimm; 
        const allowedDimms = [2, 4, 8, 12, 16, 24, 32];
        const ramAlert = document.getElementById('ramAlert');
        
        // RAM Display
        const totalRamGB = ramBase + (addRamDimm * 32);
        document.getElementById('sumRam').innerText = totalRamGB + " GB";

        if (!allowedDimms.includes(totalRamSlots) && addRamDimm > 0) {
            const next = allowedDimms.find(s => s > totalRamSlots) || 32;
            ramAlert.innerHTML = `⚠ RAM Channel Mismatch. Suggest ${next} total DIMMs.`;
            ramAlert.className = "alert-ram block";
            ramAlert.classList.remove('hidden');
        } else {
            ramAlert.classList.add('hidden');
        }

        // 2. Pool A: File (EC)
        const qFile = parseInt(document.getElementById('qtyFile').value) || 0;
        const sFile = parseFloat(document.getElementById('sizeFile').value);
        const eFile = parseFloat(document.getElementById('policyFile').value);
        const fileSafety = 0.90;

        // 3. Pool B: Block (Replica)
        const qBlock = parseInt(document.getElementById('qtyBlock').value) || 0;
        const sBlock = parseFloat(document.getElementById('sizeBlock').value);
        const eBlock = parseFloat(document.getElementById('policyBlock').value);
        const blockSafety = 0.85;

        // 4. Constants
        const binaryLoss = 931/1024;
        const emergencyBuffer = 0.85;

        // Calculations
        const fileUsable = (qFile * nodes * sFile) * binaryLoss * eFile * fileSafety;
        const blockUsable = (qBlock * nodes * sBlock) * binaryLoss * eBlock * blockSafety;
        const totalNet = (fileUsable + blockUsable) * emergencyBuffer;

        // UI Summary Updates
        document.getElementById('sumNodes').innerText = nodes + " Nodes";
        const totalDisks = qFile + qBlock + 4; // Assuming 2 cache disks per pool as baseline
        document.getElementById('sumSlots').innerText = `${totalDisks} / ${maxSlots}`;
        
        document.getElementById('sumModules').innerText = (nodes * 8) + 4;
        document.getElementById('sumCables').innerText = (nodes * 4) + 2;

        document.getElementById('sumFileUsable').innerText = fileUsable.toFixed(1) + " TB";
        document.getElementById('sumBlockUsable').innerText = blockUsable.toFixed(1) + " TB";
        document.getElementById('resUsable').innerText = totalNet.toFixed(1);

        // Ratio Check
        const fileRatio = (2 * 1.92) / (qFile * sFile);
        const resRatio = (fileRatio * 100).toFixed(1) + "%";
        document.getElementById('resRatio').innerText = resRatio;
        document.getElementById('resRatio').style.color = fileRatio >= 0.05 ? "#34d399" : "#f87171";
    }

    window.onload = runSizing;
</script>

</body>
</html>